# Optional. Leave empty to run the fully offline mock LLM (recommended for demos).
# When set, the orchestrator uses instructor + the named provider for live structured output.
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o

# Optional Neo4j. If unreachable, the engine falls back to in-memory NetworkX.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# CORS for the Next.js cockpit
FRONTEND_ORIGIN=http://127.0.0.1:3000
